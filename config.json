{
  "camera_source": 0,
  "capture_width": 1920,
  "capture_height": 1080,
  "fps": 3,
  "low_latency": true,
  "roi": [
    0,
    0,
    1920,
    1080
  ],
  "detect": {
    "diff_threshold": 25,
    "changed_ratio": 0.0015,
    "fallback_ocr_sec": 3.0,
    "stable_frames": 2,
    "confirm_ttl_sec": 4.0,
    "active_sec": 3.0,
    "min_interval_sec": 0.5
  },
  "ocr": {
    "pattern": [
      "(?:请)?\\s*([A-Z]{1,2}\\d{3,4})\\s*[到至]\\s*([A-Z]{1,2}\\d{1,2})\\s*[号窗口]",
      "(?:请)?\\s*([A-Z]{1,2}\\d{3,4})\\s*[到至]\\s*([A-Z]?\\d{1,2})\\s*[号窗口]",
      "(?:请)?\\s*([A-Z]{1,2}\\d{3,4})\\s*[到至]\\s*([A-Z]{1,2}\\d{1,2})"
    ],
    "whitelist_chars": "0123456789ABCDEFGHZ请到号窗口办理"
  },
  "tts": {
    "enabled": true,
    "engine": "auto",
    "piper_bin": null,
    "piper_model": null,
    "piper_lib_dir": null,
    "aplay_device": null,
    "gap_sec": 0.35,
    "repeat": 2,
    "rate": 135,
    "template": "请{number}到{window}号窗口办理",
    "spell_number": false
  },
  "log_file": "announce_log.csv",
  "camera_focus": 150,
  "diag_heartbeat": true,
  "diag_every_sec": 5.0
}