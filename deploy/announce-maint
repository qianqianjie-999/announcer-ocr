#!/bin/bash
# announce-maint —— Web 配置台「运维操作」执行体（sudo 白名单内）
#
# 由 config_web.py 的 POST /api/maint 调用（sudoers 只放行本脚本, 见
# deploy/sudoers.announce-maint）。四个子命令:
#   restart-service      重启播报服务 announce-rs
#   restore-substream    恢复「辅码流可用版」(紧急回退: 旧二进制+辅码流配置)
#   restore-mainstream   恢复「主码流正常版」(新二进制+备份时主码流配置)
#   reboot               延迟 5 秒重启主机(留出时间把 HTTP 响应送回浏览器)
#
# 安全设计:
#   * 恢复前把当前二进制+配置再留底一层到 backup/pre-restore-<时间戳>/,
#     任一步失败自动回滚到这份留底并重新拉起服务;
#   * 恢复包文件缺失/为空时直接拒绝, 不停服务;
#   * 不恢复 config_web.py —— 配置台保留最新版, 避免把新功能/安全修复一并回退。
set -euo pipefail

find_app_root() {
  local c
  if [[ -n "${ANNOUNCE_ROOT:-}" ]]; then
    printf '%s\n' "$ANNOUNCE_ROOT"
    return
  fi
  for c in /opt/announce-rs /home/debian/anntest /root/anntest; do
    if [[ -x "$c/announce-rs" || -r "$c/config.json" ]]; then
      printf '%s\n' "$c"
      return
    fi
  done
}

OPT="$(find_app_root)"
[[ -n "$OPT" ]] || {
  printf '[maint] 错误: 找不到 announce-rs 部署目录（可用 ANNOUNCE_ROOT 指定）\n' >&2
  exit 1
}
BK="${ANNOUNCE_BACKUP_DIR:-$OPT/backup}"
SVC=announce-rs

say() { printf '[maint] %s\n' "$*"; }
die() { printf '[maint] 错误: %s\n' "$*" >&2; exit 1; }

# 运维动作会停服并替换二进制，必须全脚本串行；双击按钮或并发请求时
# 第二个执行体直接报错，而不是与第一个互相覆盖/抢着收尸。
mkdir -p "$BK" || die "无法创建备份目录: $BK"
exec 9>"$BK/.announce-maint.lock"
flock -n 9 || die "另一个运维操作正在执行，请稍后再试"

wait_active() {
  local i
  for i in {1..20}; do
    if systemctl is-active --quiet "$SVC"; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

restart_and_verify() {
  systemctl restart "$SVC" || die "重启 $SVC 失败"
  wait_active || die "重启后 $SVC 未进入 active 状态"
  say "announce-rs 状态: active"
}

restore_files() {
  local pkg="$1" pre="$2"
  local stage_bin="$OPT/.announce-rs.restore.$$"
  local stage_cfg="$OPT/.config.json.restore.$$"
  local owner
  owner="$(stat -c '%U:%G' "$OPT/announce-rs")" || die "无法读取当前二进制属主"

  mkdir -p "$pre" || die "无法创建恢复前留底目录: $pre"
  cp -a "$OPT/announce-rs" "$pre/" || die "备份当前二进制失败，未做任何替换"
  cp -a "$OPT/config.json" "$pre/" || die "备份当前配置失败，未做任何替换"
  [[ -s "$pre/announce-rs" && -s "$pre/config.json" ]] \
    || die "恢复前留底不完整，未做任何替换"

  cp "$pkg/announce-rs" "$stage_bin" || die "暂存恢复二进制失败"
  cp "$pkg/config.json" "$stage_cfg" || die "暂存恢复配置失败"
  chown "$owner" "$stage_bin" "$stage_cfg" || die "设置暂存文件属主失败"
  chmod 755 "$stage_bin"
  chmod 644 "$stage_cfg"

  systemctl stop "$SVC" || die "停止 $SVC 失败，未替换生产文件"
  if ! mv -f "$stage_bin" "$OPT/announce-rs" \
      || ! mv -f "$stage_cfg" "$OPT/config.json"; then
    say "替换生产文件失败，开始回滚"
    cp -a "$pre/announce-rs" "$OPT/announce-rs" || true
    cp -a "$pre/config.json" "$OPT/config.json" || true
    systemctl start "$SVC" || true
    die "恢复失败，已尝试回滚到恢复前版本"
  fi

  if ! systemctl start "$SVC" || ! wait_active; then
    say "恢复版本启动失败，开始回滚"
    cp -a "$pre/announce-rs" "$OPT/announce-rs" || true
    cp -a "$pre/config.json" "$OPT/config.json" || true
    if systemctl restart "$SVC" && wait_active; then
      die "恢复版本启动失败，已回滚且旧版本服务正常"
    fi
    die "恢复版本启动失败，自动回滚后旧版本仍未恢复，请立即人工介入"
  fi
  say "announce-rs 状态: active"
}

case "${1:-}" in
  restart-service)
    restart_and_verify
    ;;

  restore-substream|restore-mainstream)
    if [ "$1" = restore-substream ]; then
      PKG=$BK/substream-ok-1023
    else
      PKG=$BK/mainstream-ok-1023
    fi
    [ -s "$PKG/announce-rs" ] || die "恢复包缺二进制或为空: $PKG/announce-rs"
    [ -s "$PKG/config.json" ] || die "恢复包缺配置或为空: $PKG/config.json"

    PRE="$BK/pre-restore-$(date +%Y%m%d-%H%M%S)"
    restore_files "$PKG" "$PRE"
    say "已执行 $1, 恢复前版本留底: $PRE"
    ;;

  reboot)
    say "主机将在 5 秒后重启…"
    (sleep 5 && /usr/sbin/reboot) &
    say "重启已排定。"
    ;;

  *)
    die "用法: announce-maint {restart-service|restore-substream|restore-mainstream|reboot}"
    ;;
esac
