[Unit]
# announce-rs Web 配置器 — 192.168.8.100:8080
# 调试人员在浏览器打开 http://192.168.8.100:8080 即可改配置(摄像头源/ROI拖框/参数)。
# 依赖: /etc/sudoers.d/announce-web 窄授权(仅 restart announce-rs), 由部署脚本写入。
Description=announce-rs Web Configurator
After=network.target announce-rs.service

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/home/debian/anntest
ExecStart=/usr/bin/python3 /home/debian/anntest/config_web.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
MemoryMax=100M

[Install]
WantedBy=multi-user.target
