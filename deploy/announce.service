[Unit]
Description=Queue number announcer (camera OCR + TTS)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/venv/bin/python __APP_DIR__/announce.py
Restart=always
RestartSec=5
User=__USER__
Environment=SDL_AUDIODRIVER=alsa

[Install]
WantedBy=multi-user.target
