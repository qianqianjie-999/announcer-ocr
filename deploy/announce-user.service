[Unit]
# ============================================================================
# 方案A（推荐）：systemd 用户级服务
# 装到: ~/.config/systemd/user/announce.service
# 启用: loginctl enable-linger $USER
#       systemctl --user daemon-reload
#       systemctl --user enable --now announce
#
# 为什么推荐用户级：CentOS/RHEL 上声卡被 pipewire 独占，直连 ALSA 会
# "Device or resource busy"。用户级服务运行在用户会话里，能直接使用
# pipewire，aplay -D default 即可出声，无需额外配环境变量。
# ============================================================================
Description=叫号屏 OCR 语音播报
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/announcer
ExecStart=%h/announcer/venv/bin/python -u announce.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 与业务服务（MySQL/Web）共存：压低优先级、限制资源，避免抢占
Nice=5
CPUWeight=50
CPUQuota=150%
MemoryMax=1500M
IOSchedulingClass=best-effort

[Install]
WantedBy=default.target
