[Unit]
Description=Announce Piper TTS server (常驻语音合成, 避免每句重载模型)
After=network.target

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/home/debian/anntest
ExecStart=/home/debian/anntest/tts/env/bin/python /home/debian/anntest/tts_server.py --model /home/debian/anntest/tts/zh_CN-huayan-medium.onnx --port 5001
Restart=always
RestartSec=5

# ---------------------------------------------------------------------------
# 资源策略(实测调优):
# 原配置 CPUQuota=150% + Nice=5 会把 onnxruntime 的多线程掐成约 1.5 核,
# 与 OCR(tesseract 常态吃 130%+)抢不到 CPU, 合成从 2.6s 恶化到 4.6~5.3s。
# 合成是偶发 2~3 秒的突发任务(不是持续负载), 不该常年受配额压制。
#   Nice=0      : 不再低人一等(tesseract 继承 announce-rs 的 Nice=5)
#   CPUWeight   : CPU 争抢时权重 800 vs announce-rs 的 50, 语音优先
#   CPUQuota=350%: 仍留一道保险, 最多吃 3.5 核, 不至于把整机占死
#   OMP_NUM_THREADS=3: 4 核里留 1 核给摄像头抓帧/OCR
# ---------------------------------------------------------------------------
Nice=0
CPUWeight=800
CPUQuota=350%
Environment=OMP_NUM_THREADS=3
MemoryMax=400M

[Install]
WantedBy=multi-user.target
